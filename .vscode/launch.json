{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Voronoi ESM",
      "runtimeArgs": ["--loader", "ts-node/esm"],
      "args": ["./src/voronoi-diagram-generator/tests/fortune.test.ts"],
      "cwd": "${workspaceFolder}/backend",
      "protocol": "inspector",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "TS_NODE_PROJECT": "./tsconfig.json"
      }
    }
  ]
}
